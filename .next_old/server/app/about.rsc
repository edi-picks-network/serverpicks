a:["$","$1","c",{"children":[["$","div",null,{"className":"relative pt-32 pb-20 px-6","children":["$","div",null,{"className":"max-w-[800px] mx-auto","children":[["$","div",null,{"className":"text-center mb-16","children":[["$","span",null,{"className":"inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-geospatial-light bg-ever-700 px-3 py-1.5 rounded-md mb-4","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-map-pin w-3 h-3","children":[["$","path","1r0f0z",{"d":"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"}],["$","circle","ilqhr7",{"cx":"12","cy":"10","r":"3"}],"$undefined"]}],"Studio #55 · Boston, MA"]}],["$","h1",null,{"className":"text-3xl md:text-5xl font-extrabold text-white tracking-tight mb-6","children":["Your Geospatial Infrastructure"," ",["$","span",null,{"className":"text-geospatial-light","children":"Benchmarking Team"}]]}],["$","p",null,{"className":"text-lg text-ever-400 leading-relaxed max-w-2xl mx-auto","children":"Ever Driven (Studio #55) is a 7-person geospatial systems team based in Boston, Massachusetts. We benchmark, compare, and recommend cloud hosting providers for geospatial and data-intensive workloads."}]]}],["$","div",null,{"className":"mb-16","children":[["$","h2",null,{"className":"text-2xl font-bold text-white mb-6","children":"Our Story"}],["$","div",null,{"className":"space-y-4 text-ever-400 leading-relaxed","children":[["$","p",null,{"children":"Ever Driven started in a shared workspace in Somerville, MA, back in 2023. Our founding team of four geospatial engineers kept running into the same problem: cloud hosting recommendations were built for web developers, not for people processing satellite imagery, running real-time GIS services, or ingesting LiDAR point clouds at scale."}],["$","p",null,{"children":"We needed to know: which cloud provider delivers the fastest GDAL raster operations? Which VPS host handles PostGIS spatial joins without falling over? How does object storage performance vary across providers when you're serving geotiff tiles to millions of users?"}],["$","p",null,{"children":"Nobody had answers. So we built our own benchmark infrastructure — a test lab in Boston running standardized geospatial workloads against every major cloud provider. Today, we've grown to a team of seven, and we publish our benchmark data openly so the geospatial community can make informed infrastructure decisions."}]]}]]}],["$","div",null,{"className":"mb-16","children":[["$","h2",null,{"className":"text-2xl font-bold text-white mb-8 text-center","children":"What Makes Us Different"}],["$","div",null,{"className":"grid grid-cols-1 md:grid-cols-2 gap-6","children":[["$","div","Geospatial Systems Focus",{"className":"bg-ever-800 border border-ever-700 rounded-xl p-6 hover:border-geospatial/50 transition-all","children":[["$","div",null,{"className":"w-12 h-12 rounded-lg bg-ever-700 flex items-center justify-center mb-4","children":["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-compass w-6 h-6 text-geospatial","children":[["$","path","9ktpf1",{"d":"m16.24 7.76-1.804 5.411a2 2 0 0 1-1.265 1.265L7.76 16.24l1.804-5.411a2 2 0 0 1 1.265-1.265z"}],["$","circle","1mglay",{"cx":"12","cy":"12","r":"10"}],"$undefined"]}]}],["$","h3",null,{"className":"text-lg font-bold text-white mb-2","children":"Geospatial Systems Focus"}],["$","p",null,{"className":"text-sm text-ever-400 leading-relaxed","children":"We specialize in infrastructure for GIS, remote sensing, spatial analytics, and location intelligence workloads — not j