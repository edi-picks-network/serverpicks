3d:["$","p","72",{"className":"text-[#839BBE] leading-relaxed mb-4 text-base","children":["❌ ",["$","strong","1",{"className":"font-bold text-[#F0F2FE]","children":"Weaknesses:"}]," Complex pricing — users report 20-30% bill surprise rates; steep learning curve; support quality varies significantly by plan level."]}]
